    "hyprland": "active-border active-border-foreground",
    "controls": "normal-fill-alpha normal-border normal-border-alpha normal-border-width "
                "hover-cursor-fill-alpha hover-cursor-border hover-cursor-border-alpha hover-cursor-border-width "
